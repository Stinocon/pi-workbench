# Never commit secrets, sessions, caches, or machine-specific state.

# Secrets — never versioned
auth.json
mcp.json
models-store.json
workers.json

# Private / machine-specific state
sessions/
trust.json
.delegate-audit.log
hook-audit.log
.pi/memory/

# Derived caches / dependencies (regenerated or index local content).
# ANCHORED to the repository root on purpose: an unanchored `rag/` also matches
# `skills/rag/`, and git then silently leaves a shipped skill untracked.
/rag/
/npm/
/venvs/
/bin/

# Python bytecode
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
